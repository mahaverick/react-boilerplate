{
  "name": "react-boilerplate",
  "private": true,
  "version": "4.1.3",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "^24.11.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11.0",
      "onFail": "error"
    }
  },
  "description": "React boilerplate for Mahaverick Labs projects",
  "author": {
    "name": "Mahaverick Labs",
    "email": "support@mahaverick.com"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "preview": "vp preview",
    "check": "vp check && eslint . --max-warnings 0",
    "lint": "vp lint && eslint . --max-warnings 0 && vp fmt --check",
    "lint:docs": "node scripts/lint-docs.mjs",
    "knip": "knip",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "format": "vp fmt",
    "test": "vp test --watch=false",
    "test:coverage": "vp test --watch=false --coverage",
    "test:shard": "COVERAGE_SHARD=1 vp test --watch=false --coverage --reporter=blob",
    "test:merge": "vp test --merge-reports --coverage",
    "test:watch": "vp test",
    "prepare": "vp config --hooks --no-agent",
    "test:e2e": "E2E_BUNDLED=1 playwright test --project=fixtures",
    "test:e2e:live": "E2E_LIVE=1 playwright test --project=live",
    "test:e2e:nginx": "docker rm -f rb-e2e >/dev/null 2>&1; docker build -t react-boilerplate:e2e . && docker run -d --name rb-e2e -p 8088:8080 --read-only --tmpfs /tmp --add-host=api:host-gateway -e POSTHOG_KEY=phc_test_key_not_real -e APP_ENVIRONMENT=ci -e ANALYTICS_HANDOFF_ORIGINS=https://www.example.test react-boilerplate:e2e >/dev/null && for i in $(seq 1 60); do curl -sf http://localhost:8088 >/dev/null && break; sleep 0.5; done && E2E_LIVE=1 E2E_NGINX=1 playwright test --project=nginx; code=$?; docker rm -f rb-e2e >/dev/null 2>&1; exit $code",
    "e2e:fake-flags": "node e2e/helpers/fake-flags.mjs",
    "test:contrast": "playwright test --project=contrast",
    "capture:pages": "E2E_CAPTURE=1 E2E_LIVE=1 playwright test --project=capture",
    "check:bundle": "node scripts/check-bundle.mjs",
    "ui:drift": "node scripts/ui-drift.mjs",
    "ui:drift:refresh": "node scripts/ui-drift.mjs --refresh",
    "gate": "pnpm check && pnpm typecheck && pnpm lint:docs && pnpm ui:drift && pnpm knip && pnpm test",
    "push": "bash scripts/push.sh"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "@posthog/core": "1.55.3",
    "@simplewebauthn/browser": "14.0.0",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-table": "9.2.4",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "posthog-js": "1.435.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "^1.63.0",
    "@posthog/cli": "0.18.9",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-query-devtools": "5.103.2",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-plugin": "1.168.40",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest-axe": "3.5.9",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "4.13.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-jsdoc": "65.1.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "jest-axe": "11.0.0",
    "jsdom": "30.1.1",
    "knip": "6.39.0",
    "msw": "2.15.0",
    "playwright": "^1.63.0",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
