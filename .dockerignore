# Installed inside the image against the Linux platform, never copied in.
node_modules
# Built inside the image. A host build copied in would be served instead.
dist
dist-ssr
build
# Also what keeps posthog-cli's inject offline (see the Dockerfile).
.git
coverage
# Playwright's output. Neither changes the bundle, and a report can be large.
test-results
playwright-report
# Never bake a developer's environment into an image. No build ARG configures
# an environment: the API prefix is fixed (see API_PREFIX in
# src/constants/routes.ts), and the Dockerfile's ARGs name the commit and
# where its source maps go.
.env
.env.*
!.env.example
*.local
# A stale incremental-build cache makes `tsc -b` skip work it should redo.
*.tsbuildinfo
.tanstack
# Docs, specs and CI config: none of them change the bundle.
.superpowers
.github
.husky
Dockerfile
.dockerignore
